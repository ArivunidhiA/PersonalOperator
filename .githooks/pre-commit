#!/bin/sh
# Scan staged changes for secrets. Enable once per clone: git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --redact || exit 1
else
  echo "gitleaks not installed (brew install gitleaks); skipping secret scan" >&2
fi
