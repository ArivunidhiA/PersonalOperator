{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/*.mjs",
    "evals/**/*.eval.ts",
    "e2e/*.spec.ts"
  ],
  "ignore": [
    "public/audio/*.js"
  ],
  "ignoreDependencies": [
    "@testing-library/jest-dom"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "files": "error"
  }
}
