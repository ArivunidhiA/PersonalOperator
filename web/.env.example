# Copy to .env.local (or run `vercel env pull .env.local`). Never commit real values.

# --- Voice (free by default) ---
# Gemini API key from https://aistudio.google.com/apikey, in a Google project with NO billing
# account linked, so it stays on the free tier and can never be charged.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_VOICE=Zubenelgenubi
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Optional PAID fallback (off unless VOICE_FALLBACK=openai): used for EEA/UK/CH visitors,
# whom the Gemini free tier may not serve.
# VOICE_FALLBACK=openai
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Optional: Claude through Vercel AI Gateway (Anthropic Messages API) for role research and
# call summaries. Claude models need AI Gateway credits (not free).
# AI_GATEWAY_API_KEY=
# LLM_PROVIDER=gateway
# AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# --- Security ---
# 32+ random chars; signs per-call tickets. `openssl rand -hex 32`
SESSION_SECRET=
# Vercel cron auth (Vercel sends it as a Bearer token).
CRON_SECRET=
# Comma-separated names the agent must never say (e.g. INZI's customers). Server-side only.
BANNED_TERMS=
# Max voice sessions per day across everyone (protects the free quota).
# DAILY_SESSION_CAP=200

# --- Storage / services (all have free tiers) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk user ids allowed to open /dashboard (comma-separated).
ANALYTICS_OWNER_IDS=
CALENDLY_API_KEY=
RESEND_API_KEY=
# EMAIL_FROM="Ariv's AI <ai@arivsai.app>"
# ARIV_NOTIFY_EMAIL=
NEXT_PUBLIC_APP_URL=https://arivsai.app
# Delete stored calls older than N days (daily cron). Unset = keep everything.
# RETENTION_DAYS=

# --- Local evals only ---
# EVAL_REPEATS=3
# EVAL_CLIENT_PROBE=
